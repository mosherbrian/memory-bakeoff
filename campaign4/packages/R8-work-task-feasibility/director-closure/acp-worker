_STATE_ROOT = os.environ.get("ACP_STATE_HOME") or os.path.expanduser("~/.config/agent-deck")
STATE_DIR = os.path.join(_STATE_ROOT, "acp-sessions")
# Streaming sidecar. The pane cannot carry structure, and the on-disk
# transcripts every agent writes only appear when a turn COMPLETES, so live
