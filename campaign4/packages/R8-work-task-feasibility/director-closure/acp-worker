RESUME = os.environ.get("ACP_RESUME", "")

CWD = os.getcwd()
# Fleet data root. A wrapper that redirects HOME for the whole session chain
# (to pin a model via a per-lane ZCode config tree) sets ACP_STATE_HOME to the
# REAL agent-deck config dir, so state/streams/transcripts stay where the
