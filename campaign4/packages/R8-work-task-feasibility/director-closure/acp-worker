#!/usr/bin/env python3
"""A generic ACP client that Agent Deck runs as a session command.

Agent Deck does not need to know what ACP is: it needs a process in a pane,
keystrokes in, text out. So the client lives in the pane. Any ACP agent works
by changing argv - this file is not ZCode-specific.

    acp-worker zcode-acp-server
    acp-worker gemini --experimental-acp

Permission requests are drawn in the exact shape conductor-chat's pane detector
already parses (rule, question, "> 1. ..." choices), so approval cards appear in
/deck with no server change.

Env:
  ACP_MODE  session mode to select after connecting (default: build).
            ZCode offers plan|build|edit|yolo|auto; "yolo" disables gating.
  ACP_MODEL pin the session model, e.g. "zai/glm-5.3". Runtime-only for this
            one session; the global config default and other sessions are
            untouched. A refusal is printed loudly, never silently ignored.
"""
import json
import os
import socket
import subprocess
import sys
import threading
import time

MODE = os.environ.get("ACP_MODE", "build")
# The longest a single turn may run. It was a hard-coded 1800s, which cut
# kiln's P6r14 candidate turn at exactly 30:00 (2026-09-22 23:19-23:49Z)
# while it waited on a long full gate, under a dispatch that allowed 60m.
# It left no text and no claim. Hangs are the stall watchdog's job
# (ACP_STALL_SECS, engine silence); this cap is only a last resort.
TURN_SECS = float(os.environ.get("ACP_TURN_SECS", "7200"))
# Let a zcode lane compact itself. zcode-acp-server calls maybeAutoCompact()
# after every prompt, but its first line is `if (threshold <= 0) return` and
# the threshold comes from THIS variable, which defaults to 0 - disabled. So
# no lane on this box had ever auto-compacted: conductor-glm's session reached
# 829,468 tokens by 2026-09-13, re-read in full every 138 seconds to emit a
# median 307 output tokens - 993 input tokens per output token written, which
# is what exhausted the Z.ai window overnight.
#
# 200k against a window of at least 830k (the largest context actually
# observed). setdefault, so a lane that wants a different number or wants it
# off can still say so. Popen inherits this environment, which is why one line
# here covers every zcode lane including stratum-glm - it runs acp-worker
# directly with no wrapper of its own.
os.environ.setdefault("ZCODE_ACP_AUTO_COMPACT_THRESHOLD", "200000")


# ---- shared concurrency gate ------------------------------------------------
# A provider can rate-limit the ACCOUNT, and every lane on it competes for the
# same allowance. Measured 2026-09-14: opencode's free tier served four
# concurrent lanes for 24 minutes without a refusal, and thirteen lanes plus
# the poller produced 123 refusals in six hours. A refusal is not a clean
# error - it arrives as a stream error inside the adapter, nothing propagates
# to ACP, and the turn hangs until the stall watchdog gives up. So exceeding
# the limit does not cost a retry, it costs ten minutes of a lane's life.
#
# Waiting for a slot is therefore strictly cheaper than being refused. Each
# lane is its own process, so the gate has to work ACROSS processes: N lock
# files, flock'd non-blocking, first one that takes is the slot. The kernel
# releases a flock when the holder dies, so a crashed or killed lane cannot
# leak a slot - which a counter in a file could not promise.
#
# Set per wrapper, not per adapter: ACP_CONCURRENCY_SLOTS=N with an optional
# ACP_CONCURRENCY_KEY to name the pool (lanes sharing one account share one
# key). Unset or 0 means no gate, which is every existing lane's behaviour.
SLOTS = int(os.environ.get("ACP_CONCURRENCY_SLOTS", "0") or 0)
SLOT_KEY = os.environ.get("ACP_CONCURRENCY_KEY", "default")
SLOT_WAIT_CAP = float(os.environ.get("ACP_CONCURRENCY_WAIT", "900"))
# A strict pool never overruns, however long the wait. For a provider whose
# plan CAPS in-flight requests (Z.ai Lite = 1) breaching it risks the account,
# so slow is the correct failure. Advisory pools (a soft rate ceiling) still
# proceed after the cap rather than stall the fleet.
SLOT_STRICT = os.environ.get("ACP_CONCURRENCY_STRICT", "0") not in ("", "0", "no")



def slot_dir():
    """Where the lock files live. Computed on use, not at import: the state
    root is defined further down this file, and naming it up here cost a
    NameError that ast.parse could not see and that would have stopped every
    lane from booting."""
    return os.path.join(os.path.dirname(STATE_DIR), "concurrency", SLOT_KEY)


class Slot:
    """Hold one of SLOTS slots for the life of a turn. A no-op when unset."""

    def __init__(self, show):
        self.fh = None
        self.show = show

    def __enter__(self):
        if SLOTS <= 0:
            return self
        import fcntl
        d = slot_dir()
        os.makedirs(d, exist_ok=True)
        start, told = time.time(), False
        while True:
            for i in range(SLOTS):
                fh = open(os.path.join(d, f"slot-{i}"), "w")
                try:
                    fcntl.flock(fh.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
                except OSError:
                    fh.close()
                    continue
                self.fh = fh
                if told:
                    self.show(f"[got a slot after {time.time()-start:.0f}s]")
                return self
            if time.time() - start > SLOT_WAIT_CAP:
                if SLOT_STRICT:
                    # STRICT pools are contractual, not advisory. Z.ai's Lite
                    # plan allows ONE request in flight and repeated breaches
                    # risk the account, so overrunning the pool is worse than
                    # being slow - keep waiting and say so every cap interval.
                    self.show(f"[still waiting for the one {SLOT_KEY} slot "
                              f"after {time.time()-start:.0f}s - this pool is "
                              f"strict, the turn will not go ungated]")
                    start = time.time()
                else:
                    # Advisory pool: going ahead beats refusing the work, but
                    # say so - a silent override would hide that the gate is
                    # too small for the offered load.
                    self.show(f"[waited {SLOT_WAIT_CAP:.0f}s for one of "
                              f"{SLOTS} {SLOT_KEY} slots and none came free - "
                              f"going ahead ungated]")
                    return self
            if not told:
                self.show(f"[waiting for one of {SLOTS} {SLOT_KEY} slots]")
                told = True
            time.sleep(1.5)

    def __exit__(self, *exc):
        if self.fh:
            self.fh.close()      # closing releases the flock
        return False
# Answer permission requests automatically. For a CONDUCTOR this is the
# difference between working and not: it runs agent-deck commands constantly,
# and claude-code-acp advertises no modes at all (measured - session/new
# returns none), so there is no "yolo" to ask for. A gated conductor stops on
# its first dispatch and waits for a human who is not watching the pane.
AUTO_OK = os.environ.get("ACP_AUTO_APPROVE", "") not in ("", "0", "no")
# Fleet-wide unattended window. One file holds an EXPIRY, and while it is in
# the future every worker answers its own permission requests - so an overnight
# run does not stop on the first approval card with nobody awake to press it.
#
# A file rather than seven wrapper edits, and read PER REQUEST rather than at
# startup, so turning it on reaches sessions that are already running and
# turning it off stops them without a restart. It expires by itself, because
# the failure mode of a forgotten switch is every session ungated for weeks.
UNATTENDED = os.path.join(
    os.environ.get("ACP_STATE_HOME") or os.path.expanduser("~/.config/agent-deck"),
    "unattended")

def unattended_until():
    """The expiry in the window file, or "" when there is no live window."""
    try:
        for line in open(UNATTENDED):
            line = line.strip()
            if not line or line.startswith("#"):
                continue
            stamp = line.rstrip("Z")
            try:
                time.strptime(stamp, "%Y-%m-%dT%H:%M:%S")
            except ValueError:
                continue  # garbage must never gate: fail closed, not open
            # Compare as text: both sides are UTC ISO-8601, which sorts.
            now = time.strftime("%Y-%m-%dT%H:%M:%S", time.gmtime())
            return line if stamp > now else ""
    except OSError:
        pass
    return ""
# Whether the mode was ASKED for, or is just our default. An explicit
# request is honoured and its refusal reported; the default is only
# applied where the adapter says it exists.
MODE_EXPLICIT = "ACP_MODE" in os.environ
MODEL = os.environ.get("ACP_MODEL", "")
# pi-acp takes its model as an ACP CONFIG OPTION (configId "model"), not as an
# env var and not through session/setModel. Same intent as ACP_MODEL, different
# call, so it gets its own switch rather than guessing which one an adapter
# wants and silently picking wrong.
CONFIG_MODEL = os.environ.get("ACP_CONFIG_MODEL", "")
# Bring an EXISTING Claude Code conversation into ACP: the id of a
# ~/.claude/projects/<slug>/<id>.jsonl transcript. claude-code-acp reads it
# from session/new's _meta and passes it to the SDK as `resume`, which
