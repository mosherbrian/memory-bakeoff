+    def new_session(self):
+        """/new: a fresh conversation for this seat, without stopping it.
+
+        Idle only. Refused while a turn runs, prompts are queued, a permission
+        answer is awaited, or another /new holds the admission lock. The old
+        session stays in use unless the adapter returns a NEW, different id.
+
+        Three records, three meanings:
+          - the reply ("new <id> ...") is the id the adapter just created;
+          - acp-history gets one "[new session] <old> -> <new>" line;
+          - acp-sessions/<seat>.json holds the new id only once it answers a
+            prompt (the proven-session rule), so until then a restart starts
+            a fresh session rather than resuming an unconfirmed one.
+        A lane pinned with ACP_RESUME is refused: /new there would reopen the
+        named conversation, which is the opposite of what was asked."""
+        if RESUME:
+            return "new refused: this lane is pinned to ACP_RESUME, so session/new would resume that conversation"
+        if not self.ctl.acquire(blocking=False):
+            return "new refused: another prompt or control change is being admitted"
+        try:
+            with self.qlock:
+                depth = len(self.queued)
+            if self.running or depth or self.pending is not None or self.transitions:
+                return ("new refused: seat busy ("
+                        + ", ".join(x for x in ("turn running" if self.running else "",
+                                                f"{depth} queued" if depth else "",
+                                                "permission pending" if self.pending is not None else "",
+                                                "compact/earlier in flight" if self.transitions else "") if x)
+                        + ") - nothing changed")
+            old = self.session
+            try:
+                new = self.call("session/new", {"cwd": CWD, "mcpServers": []})
+            except Exception as exc:
+                return f"new failed: adapter refused session/new ({exc}) - still on {old}"
+            sid = new.get("sessionId")
+            if not sid or sid == old:
+                return f"new failed: adapter returned {'no' if not sid else 'the same'} session id - still on {old}"
+            self.session, self.modes = sid, new.get("modes")
+            self.proven = self.resumed = self.stalled = False
+            self.save()
+            line = f"[new session] {old} -> {sid} (operator /new; context above this line was not carried over)"
+            self.show(line)
+            self.record("assistant", line)
+            applied = self.apply_mode() + self.apply_model() + self.apply_config_model()
+            if "REFUSED" in applied:
+                return f"new {sid} SWITCHED but{applied} - old context is gone"
+            return f"new {sid}" + applied
+        finally:
+            self.ctl.release()
+
