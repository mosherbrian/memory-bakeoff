+    def compact_or_earlier(self, text):
+        """/compact or /earlier; /new refuses while one is in flight."""
+        method = ("session/compact" if text == "/compact"
+                  else "session/load_earlier")
+        try:
+            # 330s, not 120s. zcode allows its OWN auto-compact 300s before
+            # it gives up, and compaction is a summarisation of the whole
+            # history - conductor-glm sat at a 518k context on 2026-09-13,
+            # which does not summarise in two minutes. A 120s timeout here
+            # reported "compact failed" while the backend was still working
