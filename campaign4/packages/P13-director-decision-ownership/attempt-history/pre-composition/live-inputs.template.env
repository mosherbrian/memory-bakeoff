# P13 live20 fixture inputs (TEMPLATE — late-bound fields filled at signature).
# Tern signs sha256 of the FILLED file; the driver refuses unfilled ("<...>") values.
# All paths absolute. Private HOME/ROOT isolate every effect; nothing here names
# shared production state. Times are host UTC.
RUN=<run-id, e.g. p13d1>
ROOT=<private root, e.g. /tmp/p13d1-root>
LIVE_DEADLINE=<UTC, e.g. 2026-09-24T07:00:00Z>
PROFILE=<agent-deck profile for fixture seats>
WAKE=<private ROOT/bin/wake: installed by setup from versioned plans/fixture-wake.sh; never the shared wake>
STREAMS=<private stream dir>
BIN_SRC=/home/bmosher/projects/agent-loop-releases/agent-loop-df5e6fc627b8/bin/agent-loop
BIN_SHA=47f69dfdeb8b0d17472d871b68dfdfa8270e3421997a03f5d1c6929c8a818ec1
UNITS_SRC=/home/bmosher/projects/agent-loop-releases/agent-loop-df5e6fc627b8/examples/systemd-unqualified
UNITS_SRC=/home/bmosher/projects/agent-loop-releases/agent-loop-df5e6fc627b8/examples/systemd-unqualified
W_NAME=<fixture worker title>
W_ID=<fixture worker session id>
V_NAME=<fixture verifier title>
V_ID=<fixture verifier session id>
D_NAME=<fixture director title>
D_ID=<fixture director session id>
U_NAME=<fixture duty title>
U_ID=<fixture duty session id>
# Decision ladder (fixture-only accelerated; generic policy declared below).
# Production required policy 0/300/600 is validated offline separately and is
# NOT proven by these offsets (director ruling in standin-author-release.json).
RUNG0_S=0
RUNG1_S=20
RUNG2_S=40
DECISION_WINDOW_S=60
DECISION_POLICY=
# Private escalation sinks (absolute; never shared ledger/pager).
ESC_LEDGER=<private ROOT>/escalations.jsonl
NOTIFY_CLAUDE=<private ROOT>/bin/notify-claude
RESOLVE_CMD=<private ROOT>/bin/escalation-resolve
TICKET_STUB=<private ROOT>/ticket-stub.log
# Private candidate adapters (exact reviewed hashes; installed only at signed promotion).
ADAPTER_WATCH_SRC=/home/bmosher/projects/agent-loop-p13/adapters/escalation-watch
ADAPTER_WATCH_SHA=df51a1f45a2fe8ff614645bc2fe55e445e2f4281faa5b4a7cd2550f820b1356f
ADAPTER_RESOLVE_SRC=/home/bmosher/projects/agent-loop-p13/adapters/escalation-resolve
ADAPTER_RESOLVE_SHA=fdf49d0b511ed6a225cd309b597eff2a597dee5b51bb2c614c97f1455e598ea0
NOTIFY_MODE=offline   # "live" only under a signed live run; needs NOTIFY_CLAUDE_SHA
