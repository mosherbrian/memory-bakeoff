# P12 live inputs. Late-bound values are filled at prep, then this file is hashed
# and the hash signed by Tern before live-driver.sh runs. No value may be left <...>.
RUN=<fresh run id, e.g. 20260923T1500Z; used in every qid and unit name>
ROOT=<absolute private root, e.g. /home/bmosher/p12live-RUN; must not exist yet>
LIVE_DEADLINE=<absolute UTC end of the live grant, e.g. 2026-09-23T16:00:00Z>
PROFILE=campaign4
WAKE=/home/bmosher/.config/agent-deck/wake
STREAMS=/home/bmosher/.config/agent-deck/acp-stream
BIN_SRC=/home/bmosher/projects/agent-loop-releases/agent-loop-487cb92ce9d3/bin/agent-loop
BIN_SHA=b70665f513b086ec63b0fc36d99390d78993c0a5f1657d3f51ed02a80914538d
UNITS_SRC=/home/bmosher/projects/agent-loop-releases/agent-loop-487cb92ce9d3/examples/systemd-unqualified
W_NAME=<fresh worker seat title>
W_ID=<its session id>
V_NAME=<fresh verifier seat title>
V_ID=<its session id>
D_NAME=<fresh director seat title>
D_ID=<its session id>
U_NAME=<fresh duty seat title>
U_ID=<its session id>
