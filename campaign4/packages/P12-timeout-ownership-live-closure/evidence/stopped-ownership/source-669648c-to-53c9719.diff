+// withTimeouts runs fn on a freshly opened ledger while holding the timeout
+// lock (<db>.timeouts.lock). The run loop, the outside liveness check and
+// timeout-ack all write timeout records this way, so none of them writes
+// from a stale view: no double escalation and no lost acknowledgement.
+func withTimeouts(cfg *Config, clock core.DriverClock, fn func(f *Loop) error) error {
+	fh, err := os.OpenFile(cfg.DB+".timeouts.lock", os.O_CREATE|os.O_RDWR, 0o644)
+	if err != nil {
+		return err
+	}
+	defer fh.Close()
+	if err := syscall.Flock(int(fh.Fd()), syscall.LOCK_EX); err != nil {
+		return err
+	}
+	defer syscall.Flock(int(fh.Fd()), syscall.LOCK_UN)
+	f, err := Open(cfg, clock)
+	if err != nil {
+		return err
+	}
+	defer f.Close()
+	return fn(f)
+}
+
+// EscalateTimeouts runs the never-acked and expired-ack escalations under
+// the timeout lock. run calls it after every pass; the outside liveness
+// check calls it on every check, also while run is stopped.
+func EscalateTimeouts(cfg *Config, clock core.DriverClock) ([]string, error) {
+	var out []string
+	err := withTimeouts(cfg, clock, func(f *Loop) error {
+		out = append(f.unacked(), f.expiredAcks()...)
+		return nil
+	})
+	return out, err
+}
+
