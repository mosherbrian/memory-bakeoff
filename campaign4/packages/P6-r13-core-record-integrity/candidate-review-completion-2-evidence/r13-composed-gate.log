                     "n=$(ls \"$FIXTURE_OUTBOX\" 2>/dev/null | wc -l)\n"
                     "python3 - \"$1\" \"$2\" \"$FIXTURE_OUTBOX/send-$(printf %03d $n).json\" <<'PYEOF'\n"
                     "import json,sys,time\n"
