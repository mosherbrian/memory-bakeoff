From 39b642e2b401d2ac0e36d46efe2c55e3f131b7c0 Mon Sep 17 00:00:00 2001
From: kiln <kiln@example.invalid>
Date: Fri, 25 Sep 2026 15:16:46 -0700
Subject: [PATCH] Fix clamp upper bound (inclusive) and add regression test

---
 src/num.py        | 2 +-
 tests/test_num.py | 4 ++++
 2 files changed, 5 insertions(+), 1 deletion(-)

diff --git a/src/num.py b/src/num.py
index 5e9c091..c279fd4 100644
--- a/src/num.py
+++ b/src/num.py
@@ -1,3 +1,3 @@
 def clamp(x, lo, hi):
     """Return x limited to the closed range [lo, hi]; lo <= hi."""
-    return max(lo, min(x, hi - 1))
+    return max(lo, min(x, hi))
diff --git a/tests/test_num.py b/tests/test_num.py
index 6382391..fea6e8d 100644
--- a/tests/test_num.py
+++ b/tests/test_num.py
@@ -3,3 +3,7 @@ from src.num import clamp
 
 def test_inside():
     assert clamp(5, 0, 10) == 5
+
+
+def test_upper_bound_inclusive():
+    assert clamp(10, 0, 10) == 10
-- 
2.54.0

