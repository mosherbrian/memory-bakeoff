# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# Benchmark transient queues
.memory-bakeoff-sidecar/
.sidecar-reader/
.sidecar-tfidf/
rpc_queue/

# Explicitly pulled ChatGPT -> Codex mailbox (transient; never commit).
.control-plane/

# Local external clones / dependency experiments
external/
.tmp/
tmp/

# pg0 can leave a local session marker at the process working directory.
:memory:.ses

# Embedded Postgres runtime/data can be restored on a networked host.
# Preserve provenance in research/HINDSIGHT_FINDINGS.md, not the ~33MB binary in Git history.
vendor/pg0-bin/pg0-linux-x86_64-gnu
vendor/pg0-bin/postgres-*/
vendor/pg0-bin/data/

# Interrupted Graphiti embedded-store sidecars are local derived data, not
# publishable benchmark evidence. The adjacent README is retained for audit.
results/graphiti_gen18_sentinel_strix_halo/graphiti.falkordb
results/graphiti_gen18_sentinel_strix_halo/graphiti.falkordb.settings

# OS/editor
.DS_Store
*.swp
*.swo

# Raw provider streams. These are the model's own output: far too large to
# commit, and retained instead under `raw-evidence-retention-v1` in a durable
# archive outside the repository. Gen45's survive on the workstation; Gen52's
# are in ~/gen52-raw-archive with a verified manifest in results/.
results/pi_state_control_gen45/runs/*/stdout.txt
results/pi_state_control_gen45/runs/*/history.ndjson
