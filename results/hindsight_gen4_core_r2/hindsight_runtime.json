    "provider": "rrf",
    "learned_reranker_active": false
  },
  "retrieval_arms": {
    "directly_observed": [
      "semantic",
      "keyword"
    ],
    "configured_but_not_validated_through_extracted_source_facts": [
      "graph",
      "temporal"
    ]
  },
  "host": {
    "system": "Darwin",
    "release": "25.5.0",
    "machine": "arm64",
    "python": "3.13.15"
  }
}
