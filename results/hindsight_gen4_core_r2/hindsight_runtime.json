{
  "experiment_class": "raw_product",
  "run_label": "core-r2",
  "service": {
    "package": "hindsight-api-slim",
    "version": "0.9.2"
  },
  "packages": {
    "hindsight-api-slim": "0.9.2",
    "hindsight-client": "0.9.2",
    "hindsight-embed": "0.9.2",
    "pg0-embedded": "0.15.1",
    "asyncpg": "0.31.0",
    "onnxruntime": "1.29.0",
    "transformers": "5.15.1",
    "tokenizers": "0.22.2"
  },
  "database": {
    "backend": "pg0-embedded",
    "namespace": "memory-bakeoff-gen4-core-r2"
  },
  "raw_ingestion": {
    "llm_provider": "none"
  },
  "embeddings": {
    "provider": "onnx",
    "model": "intfloat/multilingual-e5-small",
    "snapshot_revision": "614241f622f53c4eeff9890bdc4f31cfecc418b3",
    "dimensions": 384,
    "pooling": "mean",
    "normalize": true,
