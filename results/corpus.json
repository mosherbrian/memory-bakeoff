    {
      "id": "M023",
      "text": "For stale generated Go code: edit the source schema, run the generator, inspect the generated diff, run package tests, then run the full suite.",
      "timestamp": "2026-04-01T10:00:00+00:00",
      "session_id": "s11",
      "scope": "repo:demo",
