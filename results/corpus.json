    {
      "id": "M024",
      "text": "Editing generated Go files directly made the immediate test pass but failed regeneration checks in CI.",
      "timestamp": "2026-04-01T10:20:00+00:00",
      "session_id": "s11",
      "scope": "repo:demo",
      "metadata": {
        "procedure_family": "generated-code"
