  ]
 },
 "instruction": "Answer the question using only the records provided.\nReply with a single JSON object and nothing else: {\"answer\": \"<your answer>\", \"citations\": [\"<record id>\", ...]}\nIf the records do not answer the question, reply exactly {\"answer\": \"INSUFFICIENT\", \"citations\": []}.",
