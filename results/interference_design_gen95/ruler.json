   "stale_version_interference",
   "cross_scope_contamination",
   "retrieval_window_effect"
  ],
  "per_case_rank_and_provenance_preserved": true,
  "question": "what happens when the store contains many plausible distractors and competing memories?",
  "rules_carried_from_round_2": {
   "fair_bindings": "every observation carries a scope and a configuration; the adapter must bind both on write and query",
   "layers_apart": "no case asks for a judgement, and none can only be passed by returning nothing",
   "no_pooled_score": "score_case returns mechanisms; assert_no_pooled_accuracy refuses a scale score",
   "reachability_first": "every class is driven by a synthetic control before any product sees the fixture"
  },
  "scorer_version": "interference-scorer-v1",
  "the_pair_that_matters": {
   "distractor_displacement": "the current fact is absent and the window is saturated with same-core distractors",
   "true_forgetting": "the current fact is absent and the window was NOT filled by same-core competitors",
   "why": "identical in any pooled count, and completely different fixes"
  }
 },
