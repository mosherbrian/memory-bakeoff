    "failure_semantics": {
      "judge_omits_a_metric_key": {
        "is_measured_zero": false,
        "our_treatment": "UNMEASURED",
        "upstream_behaviour": "parse_llm_metric_result reads parsed_result.get(metric_key, 0), so a missing key scores zero"
      },
      "llm_judge_unavailable_or_raising": {
        "is_measured_zero": false,
        "our_treatment": "UNMEASURED, and the lane is named upstream_rule_fallback, never merged with upstream_llm_judge",
        "upstream_behaviour": "evaluate_question_with_llm catches every exception and returns None; Evaluate_Single_Question then falls back to build_rule_based_result, which leaves all white-box metrics at 0.0 although nothing was measured"
      },
      "missing_model_answer": {
        "is_measured_zero": false,
        "our_treatment": "UNMEASURED",
        "upstream_behaviour": "build_missing_answer_result returns every metric as 0.0 with Error_Tags=['missing_model_answer']"
      },
      "unparsable_support_rank": {
        "is_measured_zero": false,
        "our_treatment": "UNMEASURED",
        "upstream_behaviour": "parse_support_rank returns 0 on any parse failure, which reads as a miss"
      }
    },
