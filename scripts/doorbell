#!/usr/bin/env python3
"""Ring a BAKEOFF_HANDOFF doorbell. The only sanctioned way to ring one.

Refuses without a plain-English recap. Brian follows this project through the
recap, not the artifacts. When the loop moved from the ChatGPT chat onto GitHub
and Drive the recaps quietly stopped - the technical summaries kept flowing and
the readable ones did not, for five generations. This makes that structurally
impossible: no recap, no doorbell.

Then this script itself was never invoked, so the guard against quiet lapses
quietly lapsed, and on 2026-09-06 a hand-typed doorbell titled "Doorbell: ..."
missed the control plane's BAKEOFF_HANDOFF title filter. The webhook never fired
and the loop idled six hours against a control plane that was never called.
Everything below exists because of a specific failure:

  recap gate        recaps stopped for five generations
  title built here  a hand-typed title cost six hours
  origin/main pin   ringing leaves the checkout on the doorbell branch, and
                    HEAD there is not the published result
  clean-tree incl.
  untracked files   filtering '??' let a drill fire a live doorbell (PR #17)
  review gate       two doorbells rang after a FIX FIRST verdict, unreviewed
  --fire required   a script whose only purpose is an irreversible outward
                    effect had no safe way to test it

Usage: scripts/doorbell [--fire] <generation> <recap-file> <technical-file>
Without --fire it checks every gate and creates nothing.
"""
from __future__ import annotations

import json, os, subprocess, sys, urllib.request
from pathlib import Path

REPO = "mosherbrian/memory-bakeoff"
MIN_RECAP_CHARS = 200
JARGON = ("sha256", "manifest", "contract_version", "opaque_id", "attempt1",
          "FROZEN_UNRUN", "NON_EVIDENCE", "source_commit", "truth_matrix")


def token() -> str:
    line = next(l for l in Path.home().joinpath(".config/gh/hosts.yml")
                .read_text().splitlines() if "oauth_token:" in l)
    return line.split(":", 1)[1].strip()


def git(*args: str) -> str:
    return subprocess.run(["git", *args], capture_output=True, text=True).stdout.strip()


def preflight(generation: str) -> str:
    """Every gate that is not about the recap. Returns the commit to pin."""
    git("fetch", "-q", "origin", "main")
    commit, local = git("rev-parse", "origin/main"), git("rev-parse", "main")
    if not commit:
        raise SystemExit("REFUSED: cannot resolve origin/main")
    if local != commit:
        raise SystemExit(f"REFUSED: local main {local[:12]} != origin/main "
                         f"{commit[:12]}; push or rebase first")
    dirt = git("status", "--porcelain")
    if dirt:
        raise SystemExit("REFUSED: worktree is not clean (tracked or untracked):\n"
                         + "\n".join("  " + l for l in dirt.splitlines()))

    # A doorbell may not ring while review says otherwise, or on an unreviewed
    # commit. Gen116 rang twice without the fix being re-reviewed.
    reviews = sorted(Path.home().joinpath("rivals/reviews").glob("*/decision.txt"),
                     key=lambda q: q.stat().st_mtime)
    if not reviews:
        raise SystemExit("REFUSED: no rival review found. Run review-generation first.")
    verdict = reviews[-1].read_text().strip().splitlines()[0]
    # PROCEED or CARRY. The reviewers assign severity; this honours it rather than
    # overriding it. DEFECTS_BLOCKING still produces FIX FIRST and still refuses -
    # that is the case this gate exists for. DEFECTS_MINOR produces CARRY, and its
    # findings must be in the ledger as CARRIED before the bell rings, so nothing
    # is dropped by proceeding. See decisions/gen120-review-severity.md; authorised
    # by Brian 2026-09-06 after five rounds none of which returned BLOCKING.
    if verdict not in ("PROCEED", "CARRY"):
        raise SystemExit(f"REFUSED: latest rival verdict is {verdict!r} "
                         f"({reviews[-1].parent.name}). Fix, re-review, then ring.")
    head_time = int(git("log", "-1", "--format=%ct") or 0)
    if reviews[-1].stat().st_mtime < head_time:
        raise SystemExit(f"REFUSED: the latest review ({reviews[-1].parent.name}) is "
                         "older than HEAD. Re-review the commit you are ringing.")

    # The suite must be green AT THIS COMMIT, and green means "no failure we have
    # not already accounted for" - not a familiar-looking total. Twice I reported
    # a red suite as normal because the count matched; a count is not an identity,
    # and 24 failures can become a different 24 while the number holds still.
    #
    # This RUNS the check rather than reading a recorded result. A receipt can be
    # stale, and trusting one would repeat exactly the mistake the F2 finding was
    # about: taking an authored claim where an observation was available.
    root = Path(__file__).resolve().parents[1]
    # RECURSION GUARD. The gate runs the suite; the suite contains
    # tests/test_doorbell_guards.py, which invokes this very script; that nested
    # doorbell would run the suite again, forever. I introduced this loop in the
    # same commit that added the gate, and it hung the first real ring.
    #
    # The nested call inherits this variable and skips the gate. The outer call -
    # the one a human or the handoff actually made - still runs it, so the gate
    # keeps its teeth exactly where it matters.
    if os.environ.get("DOORBELL_SUITE_RUNNING"):
        print("  known-failures gate: SKIPPED (nested inside the suite it would run)")
        return commit
    print("  running the known-failures gate (about 45s) ...")
    baseline = subprocess.run(
        [sys.executable, "-m", "pytest", "-q", "-p", "no:cacheprovider",
         "tests/test_known_failures_baseline.py"],
        cwd=root, capture_output=True, text=True,
        env={**os.environ, "PYTHONPATH": "src:vendor/membukkit/src",
             "DOORBELL_SUITE_RUNNING": "1"},
        timeout=2400)
    if baseline.returncode != 0:
        tail = "\n".join((baseline.stdout + baseline.stderr).splitlines()[-25:])
        raise SystemExit("REFUSED: the suite has failures that are not in "
                         "tests/KNOWN_FAILURES.json, or listed ones that now pass. "
                         "Either is a real change and must be understood before a "
                         f"handoff claims a clean run:\n{tail}")

    ledger = Path(__file__).resolve().parents[1] / "reviews/LEDGER.md"
    if ledger.exists():
        text = ledger.read_text()
        open_rows = [l for l in text.splitlines() if "| OPEN |" in l]
        if open_rows:
            raise SystemExit(f"REFUSED: {len(open_rows)} finding(s) still OPEN in "
                             "reviews/LEDGER.md. Close them, or mark them CARRIED "
                             "with an owner if review ruled them minor.")
        # A CARRY verdict requires that the carrying actually happened. Otherwise
        # "minor" becomes a way to drop findings silently, which is the failure
        # the ledger was built to stop.
        if verdict == "CARRY" and "| CARRIED |" not in text:
            raise SystemExit("REFUSED: review returned CARRY but no finding is "
                             "marked CARRIED in reviews/LEDGER.md. Record them "
                             "before ringing - carrying is not the same as ignoring.")
    return commit


def main() -> int:
    argv = sys.argv[1:]
    fire = "--fire" in argv
    argv = [a for a in argv if a != "--fire"]
    if len(argv) != 3:
        print(__doc__)
        return 2
    generation, recap_path, technical_path = argv[0], Path(argv[1]), Path(argv[2])
    if not recap_path.is_file():
        raise SystemExit(f"REFUSED: no recap at {recap_path}")
    if not technical_path.is_file():
        raise SystemExit(f"REFUSED: no technical summary at {technical_path}")
    recap = recap_path.read_text().strip()

    # The gate. A recap that is absent, stubbed, or written in contract-speak is
    # not a recap.
    if len(recap) < MIN_RECAP_CHARS:
        raise SystemExit(f"REFUSED: recap is {len(recap)} chars, need "
                         f"{MIN_RECAP_CHARS}. Brian reads this, not the artifacts.")
    leaked = [j for j in JARGON if j.lower() in recap.lower()]
    if leaked:
        raise SystemExit(f"REFUSED: recap contains jargon {leaked}. Write it for "
                         "someone who has not read the brief.")

    sha = preflight(generation)
    body = (f"**source_generation: {generation}**\n**source_commit: {sha}**\n\n"
            f"## In plain English\n\n{recap}\n\n---\n\n"
            f"{technical_path.read_text().strip()}\n\n"
            f"Please write the next instruction with "
            f"`source_generation: {generation}`, `source_commit: {sha}`.\n\n"
            "**main is frozen until consumed.** Doorbell only - do not merge.")
    title = f"BAKEOFF_HANDOFF Gen{generation}"
    if not title.startswith("BAKEOFF_HANDOFF"):
        raise SystemExit("REFUSED: title must carry the control plane's filter prefix")
    if not fire:
        print("DRY RUN - nothing was created. Every gate passed.")
        print(f"  title  : {title}")
        print(f"  pin    : {sha}")
        print(f"  recap  : {len(recap)} chars, no jargon")
        print("Re-run with --fire to actually ring.")
        return 0

    branch = f"bakeoff-handoff-gen{generation}"
    if branch not in git("ls-remote", "--heads", "origin", branch):
        subprocess.run(["git", "checkout", "-q", "-b", branch], check=True)
        Path(f".doorbell-gen{generation}.txt").write_text(
            f"doorbell: gen{generation}\nsource_commit: {sha}\n")
        subprocess.run(["git", "add", f".doorbell-gen{generation}.txt"], check=True)
        subprocess.run(["git", "commit", "-q", "-m",
                        f"Doorbell: Gen{generation} complete"], check=True)
        subprocess.run(["git", "push", "-q", "-u", "origin", branch], check=True)
        subprocess.run(["git", "checkout", "-q", "main"], check=True)

    payload = json.dumps({
        "title": title,
        "head": f"bakeoff-handoff-gen{generation}", "base": "main",
        "body": body}).encode()
    request = urllib.request.Request(
        f"https://api.github.com/repos/{REPO}/pulls", data=payload,
        headers={"Authorization": f"Bearer {token()}",
                 "Accept": "application/vnd.github+json",
                 "X-GitHub-Api-Version": "2022-11-28"})
    with urllib.request.urlopen(request) as response:
        result = json.loads(response.read())
    number = result["number"]

    # NOTE, 2026-09-06: the PR trigger is DISABLED. This PR no longer summons
    # the control plane; it is an artifact record. Delivery now happens through
    # control-plane/PENDING.json, which a scheduled task reads, so the doorbell
    # updates that file and the watcher verifies it.
    #
    # The ring still ARMS the clock. There is no second decision about whether to
    # watch, because "am I stuck?" is the judgement that cost 6h47m.
    title_back = result.get("title", "")
    if not title_back.startswith("BAKEOFF_HANDOFF"):
        raise SystemExit(f"RANG BUT MALFORMED: GitHub shows title {title_back!r}. "
                         "The control plane filter will not match it. Close it and re-ring.")
    subprocess.run([str(Path(__file__).resolve().parent / "pending"),
                    "await", str(generation), sha], check=True)
    subprocess.run(["git", "add", "control-plane/PENDING.json"], check=False)
    subprocess.run(["git", "commit", "-q", "-m",
                    f"pending: awaiting gen{generation + 1} from {sha[:12]}"], check=False)
    subprocess.run(["git", "push", "-q", "origin", "HEAD:main"], check=False)

    unit = f"doorbell-gen{generation}"
    subprocess.run(["systemd-run", "--user", f"--unit={unit}", "--collect",
                    str(Path(__file__).resolve().parent / "await-instruction"),
                    str(generation), str(number), sha], check=False)
    print(f"doorbell PR {number} | recap {len(recap)} chars | watcher {unit} armed")
    print("  rungs: answer+request every 5m | 15m wake agent | 45m wake Brian")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
